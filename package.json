{
  "name": "opencode-sessions",
  "displayName": "OpenCode",
  "description": "OpenCode sessions in the VS Code sidebar, each session in its own ACP chat tab.",
  "publisher": "abyss7",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abyss7/opencode-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/abyss7/opencode-vscode/issues"
  },
  "homepage": "https://github.com/abyss7/opencode-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:opencode.sessions",
    "onWebviewPanel:opencode.session"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "opencode.sessionEditor",
        "displayName": "OpenCode Session",
        "selector": [{ "filenamePattern": "*.opencode-session" }],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode",
          "title": "OpenCode",
          "icon": "media/opencode.svg"
        }
      ]
    },
    "views": {
      "opencode": [
        {
          "id": "opencode.sessions",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "opencode.sessions",
        "contents": "There are no OpenCode sessions in this workspace yet.\n[New Session](command:opencode.newSession)"
      }
    ],
    "commands": [
      {
        "command": "opencode.selectDefaultAgent",
        "title": "Select Agent for New Sessions",
        "category": "OpenCode"
      },
      {
        "command": "opencode.newSession",
        "title": "New Session",
        "category": "OpenCode",
        "icon": "$(add)"
      },
      {
        "command": "opencode.refreshSessions",
        "title": "Refresh Sessions",
        "category": "OpenCode",
        "icon": "$(refresh)"
      },
      {
        "command": "opencode.deleteSession",
        "title": "Delete Session",
        "category": "OpenCode",
        "icon": "$(trash)"
      },
      {
        "command": "opencode.newFolder",
        "title": "New Folder",
        "category": "OpenCode",
        "icon": "$(new-folder)"
      },
      {
        "command": "opencode.deleteFolder",
        "title": "Delete Folder",
        "category": "OpenCode",
        "icon": "$(trash)"
      },
      {
        "command": "opencode.renameSession",
        "title": "Rename Session",
        "category": "OpenCode",
        "icon": "$(edit)"
      },
      {
        "command": "opencode.archiveSession",
        "title": "Archive Session",
        "category": "OpenCode",
        "icon": "$(archive)"
      },
      {
        "command": "opencode.restoreSession",
        "title": "Restore Session",
        "category": "OpenCode",
        "icon": "$(history)"
      },
      {
        "command": "opencode.moveSessionTo",
        "title": "Move to Folder…",
        "category": "OpenCode"
      },
      {
        "command": "opencode.showLog",
        "title": "Show Log",
        "category": "OpenCode",
        "icon": "$(output)"
      },
      {
        "command": "opencode.openSettings",
        "title": "Open Settings",
        "category": "OpenCode",
        "icon": "$(gear)"
      },
      {
        "command": "opencode.openGlobalConfig",
        "title": "Open Global Config (JSON)",
        "category": "OpenCode"
      },
      {
        "command": "opencode.openPermissionRules",
        "title": "Open Permission Rules (JSON)",
        "category": "OpenCode"
      },
      {
        "command": "opencode.openProjectConfig",
        "title": "Open Project Config (JSON)",
        "category": "OpenCode"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "opencode.deleteSession",
          "when": "false"
        },
        {
          "command": "opencode.deleteFolder",
          "when": "false"
        },
        {
          "command": "opencode.renameSession",
          "when": "false"
        },
        {
          "command": "opencode.archiveSession",
          "when": "false"
        },
        {
          "command": "opencode.restoreSession",
          "when": "false"
        },
        {
          "command": "opencode.moveSessionTo",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "opencode.openSettings",
          "when": "view == opencode.sessions",
          "group": "navigation@0"
        },
        {
          "command": "opencode.newFolder",
          "when": "view == opencode.sessions",
          "group": "navigation@1"
        },
        {
          "command": "opencode.newSession",
          "when": "view == opencode.sessions",
          "group": "navigation@2"
        },
        {
          "command": "opencode.refreshSessions",
          "when": "view == opencode.sessions",
          "group": "navigation@3"
        }
      ],
      "webview/context": [
        {
          "command": "opencode.openSession",
          "when": "webviewId == opencode.sessions && sidebarKind == session",
          "group": "navigation@1"
        },
        {
          "command": "opencode.renameSession",
          "when": "webviewId == opencode.sessions && sidebarKind == session && !sidebarSubagent",
          "group": "1_manage@1"
        },
        {
          "command": "opencode.moveSessionTo",
          "when": "webviewId == opencode.sessions && sidebarKind == session && !sidebarSubagent",
          "group": "1_manage@2"
        },
        {
          "command": "opencode.archiveSession",
          "when": "webviewId == opencode.sessions && sidebarKind == session && !sidebarSubagent && !sidebarArchived",
          "group": "1_manage@3"
        },
        {
          "command": "opencode.restoreSession",
          "when": "webviewId == opencode.sessions && sidebarKind == session && sidebarArchived",
          "group": "1_manage@3"
        },
        {
          "command": "opencode.deleteSession",
          "when": "webviewId == opencode.sessions && sidebarKind == session",
          "group": "2_delete@1"
        },
        {
          "command": "opencode.deleteFolder",
          "when": "webviewId == opencode.sessions && sidebarKind == folder && sidebarCustom",
          "group": "2_delete@1"
        }
      ],
      "view/item/context": [
        {
          "command": "opencode.archiveSession",
          "when": "view == opencode.sessions && viewItem == opencode.session",
          "group": "inline@1"
        },
        {
          "command": "opencode.deleteSession",
          "when": "view == opencode.sessions && viewItem == opencode.session",
          "group": "inline@2"
        },
        {
          "command": "opencode.restoreSession",
          "when": "view == opencode.sessions && viewItem == opencode.session.archived",
          "group": "inline@1"
        },
        {
          "command": "opencode.deleteSession",
          "when": "view == opencode.sessions && viewItem == opencode.session.archived",
          "group": "inline@2"
        },
        {
          "command": "opencode.deleteSession",
          "when": "view == opencode.sessions && viewItem == opencode.session.subagent",
          "group": "inline@1"
        },
        {
          "command": "opencode.deleteFolder",
          "when": "view == opencode.sessions && viewItem == opencode.folder",
          "group": "inline@1"
        },
        {
          "command": "opencode.moveSessionTo",
          "when": "view == opencode.sessions && viewItem == opencode.session",
          "group": "1_manage@1"
        },
        {
          "command": "opencode.moveSessionTo",
          "when": "view == opencode.sessions && viewItem == opencode.session.archived",
          "group": "1_manage@1"
        },
        {
          "command": "opencode.renameSession",
          "when": "view == opencode.sessions && viewItem == opencode.session",
          "group": "1_manage@2"
        },
        {
          "command": "opencode.renameSession",
          "when": "view == opencode.sessions && viewItem == opencode.session.archived",
          "group": "1_manage@2"
        },
        {
          "command": "opencode.archiveSession",
          "when": "view == opencode.sessions && viewItem == opencode.session",
          "group": "1_manage@3"
        },
        {
          "command": "opencode.restoreSession",
          "when": "view == opencode.sessions && viewItem == opencode.session.archived",
          "group": "1_manage@3"
        },
        {
          "command": "opencode.deleteSession",
          "when": "view == opencode.sessions && viewItem == opencode.session",
          "group": "2_delete@1"
        },
        {
          "command": "opencode.deleteSession",
          "when": "view == opencode.sessions && viewItem == opencode.session.archived",
          "group": "2_delete@1"
        },
        {
          "command": "opencode.deleteFolder",
          "when": "view == opencode.sessions && viewItem == opencode.folder",
          "group": "1_delete@1"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "opencode.shell": {
          "scope": "resource",
          "markdownDescription": "**Shell**\n\nDefault shell to use for terminal and shell tool execution\n\nOpenCode key: `shell`",
          "order": 10,
          "type": "string"
        },
        "opencode.model": {
          "scope": "resource",
          "markdownDescription": "**Default model**\n\nModel used for new sessions unless the session or agent selects another one. The list is filled from the installed models when the extension starts; after adding or enabling a model, run **Developer: Reload Window** to refresh it.\n\nOpenCode key: `model`\n\nStored as `provider/model` or `provider/model#variant`.",
          "order": 20,
          "type": "string",
          "pattern": "^[^/#]+\\/[^#]+(?:#[^#]+)?$"
        },
        "opencode.default_agent": {
          "scope": "resource",
          "markdownDescription": "**Default agent**\n\nPrimary agent used for new sessions unless the session selects another one. The list is filled from the installed agents when the extension starts; after adding an agent, run **Developer: Reload Window** to refresh it.\n\nOpenCode key: `default_agent`",
          "order": 30,
          "type": "string",
          "enum": [
            "build",
            "plan"
          ],
          "enumDescriptions": [
            "The default agent. Executes tools based on configured permissions.",
            "Read-only agent for exploring the codebase and planning work before implementation."
          ]
        },
        "opencode.permissions": {
          "scope": "resource",
          "markdownDescription": "**Permissions**\n\nOrdered tool permission rules applied to agent tool use.\n\nOpenCode key: `permissions`\n\nVS Code does not render this structured value; use **Edit in settings.json** to set the full value.",
          "order": 40,
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "opencode.policies": {
          "scope": "resource",
          "markdownDescription": "**Policies**\n\nOrdered policies controlling access to providers, tools, and integrations.\n\nOpenCode key: `policies`\n\nVS Code does not render this structured value; use **Edit in settings.json** to set the full value.",
          "order": 50,
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "opencode.agents": {
          "scope": "resource",
          "markdownDescription": "**Agents**\n\nNamed built-in agent overrides and custom agent definitions.\n\nOpenCode key: `agents`\n\nVS Code does not render this structured value; use **Edit in settings.json** to set the full value.",
          "order": 60,
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "opencode.watcher.ignore": {
          "scope": "resource",
          "markdownDescription": "**Ignored paths**\n\nOpenCode key: `watcher.ignore`",
          "order": 70,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "opencode.formatter": {
          "scope": "resource",
          "markdownDescription": "**Formatting**\n\nEnable built-in formatters or configure formatter overrides.\n\nOpenCode key: `formatter`\n\nVS Code does not render this structured value; use **Edit in settings.json** to set the full value.",
          "order": 80,
          "default": false,
          "type": [
            "boolean",
            "object"
          ],
          "additionalProperties": {
            "type": "object"
          }
        },
        "opencode.lsp": {
          "scope": "resource",
          "markdownDescription": "**Language servers**\n\nEnable built-in language servers or configure server overrides.\n\nOpenCode key: `lsp`\n\nVS Code does not render this structured value; use **Edit in settings.json** to set the full value.",
          "order": 90,
          "type": [
            "boolean",
            "object"
          ],
          "additionalProperties": {
            "type": "object"
          }
        },
        "opencode.media.image.auto_resize": {
          "scope": "resource",
          "markdownDescription": "**Auto-resize images**\n\nOpenCode key: `media.image.auto_resize`",
          "order": 100,
          "type": "boolean"
        },
        "opencode.media.image.max_width": {
          "scope": "resource",
          "markdownDescription": "**Maximum image width**\n\nOpenCode key: `media.image.max_width`",
          "order": 110,
          "type": "integer"
        },
        "opencode.media.image.max_height": {
          "scope": "resource",
          "markdownDescription": "**Maximum image height**\n\nOpenCode key: `media.image.max_height`",
          "order": 120,
          "type": "integer"
        },
        "opencode.media.image.max_base64_bytes": {
          "scope": "resource",
          "markdownDescription": "**Maximum image size (bytes)**\n\nOpenCode key: `media.image.max_base64_bytes`",
          "order": 130,
          "type": "integer"
        },
        "opencode.tool_output.max_lines": {
          "scope": "resource",
          "markdownDescription": "**Maximum output lines**\n\nMaximum lines of tool output before it is truncated and saved to disk (default: 2000)\n\nOpenCode key: `tool_output.max_lines`",
          "order": 140,
          "default": 2000,
          "type": "integer"
        },
        "opencode.tool_output.max_bytes": {
          "scope": "resource",
          "markdownDescription": "**Maximum output bytes**\n\nMaximum bytes of tool output before it is truncated and saved to disk (default: 51200)\n\nOpenCode key: `tool_output.max_bytes`",
          "order": 150,
          "default": 51200,
          "type": "integer"
        },
        "opencode.mcp.timeout.startup": {
          "scope": "resource",
          "markdownDescription": "**MCP startup timeout**\n\nOpenCode key: `mcp.timeout.startup`",
          "order": 160,
          "type": "integer"
        },
        "opencode.mcp.timeout.catalog": {
          "scope": "resource",
          "markdownDescription": "**MCP catalog timeout**\n\nOpenCode key: `mcp.timeout.catalog`",
          "order": 170,
          "type": "integer"
        },
        "opencode.mcp.timeout.execution": {
          "scope": "resource",
          "markdownDescription": "**MCP execution timeout**\n\nOpenCode key: `mcp.timeout.execution`",
          "order": 180,
          "type": "integer"
        },
        "opencode.mcp.servers": {
          "scope": "resource",
          "markdownDescription": "**MCP servers**\n\nConfigure local and remote Model Context Protocol servers.\n\nOpenCode key: `mcp.servers`\n\nVS Code does not render this structured value; use **Edit in settings.json** to set the full value.",
          "order": 190,
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "opencode.compaction.auto": {
          "scope": "resource",
          "markdownDescription": "**Automatic compaction**\n\nEnable automatic compaction when context is full (default: true)\n\nOpenCode key: `compaction.auto`",
          "order": 200,
          "default": true,
          "type": "boolean"
        },
        "opencode.compaction.keep.tokens": {
          "scope": "resource",
          "markdownDescription": "**Retained context tokens**\n\nOpenCode key: `compaction.keep.tokens`",
          "order": 210,
          "type": "integer",
          "minimum": 0
        },
        "opencode.compaction.buffer": {
          "scope": "resource",
          "markdownDescription": "**Compaction buffer**\n\nOpenCode key: `compaction.buffer`",
          "order": 220,
          "type": "integer",
          "minimum": 0
        },
        "opencode.skills": {
          "scope": "resource",
          "markdownDescription": "**Skill paths**\n\nAdditional paths or URLs to discover skills from.\n\nOpenCode key: `skills`",
          "order": 230,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "opencode.commands": {
          "scope": "resource",
          "markdownDescription": "**Commands**\n\nNamed slash command definitions.\n\nOpenCode key: `commands`\n\nVS Code does not render this structured value; use **Edit in settings.json** to set the full value.",
          "order": 240,
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "opencode.instructions": {
          "scope": "resource",
          "markdownDescription": "**Instruction files**\n\nAdditional instruction files, globs, or HTTP(S) URLs.\n\nOpenCode key: `instructions`",
          "order": 250,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "opencode.references": {
          "scope": "resource",
          "markdownDescription": "**References**\n\nNamed local directories or Git repositories available as supporting context.\n\nOpenCode key: `references`\n\nVS Code does not render this structured value; use **Edit in settings.json** to set the full value.",
          "order": 260,
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "opencode.websearch": {
          "scope": "resource",
          "markdownDescription": "**Web search**\n\nChoose how OpenCode searches the web.\n\nOpenCode key: `websearch`\n\nVS Code does not render this structured value; use **Edit in settings.json** to set the full value.\n\nSet `false` in `opencode.json(c)` to disable web search.",
          "order": 270,
          "type": [
            "object",
            "boolean"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "description": "Web search provider ID, or \"random\" to pick one automatically."
            }
          },
          "additionalProperties": false
        },
        "opencode.plugins": {
          "scope": "resource",
          "markdownDescription": "**Plugins**\n\nOrdered plugin enablement directives and external package declarations.\n\nOpenCode key: `plugins`\n\nVS Code does not render this structured value; use **Edit in settings.json** to set the full value.",
          "order": 280,
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "opencode.providers": {
          "scope": "resource",
          "markdownDescription": "**Providers**\n\nConfigure providers and add or override their models and request settings.\n\nOpenCode key: `providers`\n\nVS Code does not render this structured value; use **Edit in settings.json** to set the full value.",
          "order": 290,
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "opencodeSessions.defaultAgent": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Agent for newly created VS Code sessions. Empty uses opencode.default_agent. Existing sessions keep their agent."
        },
        "opencodeSessions.defaultPermissionProfile": {
          "type": "string",
          "default": "workspace",
          "scope": "resource",
          "description": "Permission profile for a new session unless its agent has a profile assignment. Built-ins: read-only, workspace, host, all. Host currently behaves like All."
        },
        "opencodeSessions.allowSessionTemp": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Allow file access and edits in the current session's temporary directory without prompting, unless explicitly denied. Each session gets its own directory and shell `TMPDIR`/`TMP`/`TEMP` and `OUT`. Other sessions' directories and shell command approvals keep their normal permissions. Changes apply on the next turn."
        },
        "opencodeSessions.sessionTempBaseDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Host base directory for session temporary files. Empty uses the host's system temporary directory (`TMPDIR` on Linux). Set an absolute path or `~/...` to override it. Session files go under `<base>/opencode/sessions/<sessionID>/`. Changes apply on the next turn."
        },
        "opencodeSessions.smartTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 120,
          "scope": "resource",
          "description": "Maximum duration of permission-classifier review for Smart new actions. Timeout blocks the operation."
        },
        "opencodeSessions.agentPermissionProfiles": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": { "type": "string" },
          "description": "Agent ID to default permission profile ID. Used only when initializing a session."
        },
        "opencodeSessions.permissionProfiles": {
          "type": "object",
          "default": {},
          "scope": "application",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "newActions": { "type": "string", "enum": ["forbid", "ask", "smart", "permit"] },
              "rules": { "type": "array", "items": {
                "type": "object", "additionalProperties": false,
                "required": ["action", "resource", "effect"],
                "properties": { "action": { "type": "string", "minLength": 1 }, "resource": { "type": "string", "minLength": 1 }, "effect": { "type": "string", "enum": ["allow", "ask", "deny"] }, "match": { "type": "string", "enum": ["glob", "exact"], "default": "glob" } }
              } }
            }
          },
          "markdownDescription": "User permission layers. Built-ins: `read-only`, `workspace`, `host`, `all`. Each profile has `rules: [{action, resource, effect, match?}]` and optional `newActions: forbid | ask | smart | permit`. `match` defaults to `glob`; `exact` treats resource wildcards literally. Project remembered decisions can answer asks but cannot override explicit denies. See docs/permission-profiles.md."
        },
        "opencodeSessions.hostPermissionProfiles": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "newActions": { "type": "string", "enum": ["forbid", "ask", "smart", "permit"] },
              "rules": { "type": "array", "items": {
                "type": "object", "additionalProperties": false,
                "required": ["action", "resource", "effect"],
                "properties": { "action": { "type": "string", "minLength": 1 }, "resource": { "type": "string", "minLength": 1 }, "effect": { "type": "string", "enum": ["allow", "ask", "deny"] }, "match": { "type": "string", "enum": ["glob", "exact"], "default": "glob" } }
              } }
            }
          },
          "markdownDescription": "Host permission layer (Remote settings in a remote window). Combined with User restrictions, never replaced by workspace rules."
        },
        "opencodeSessions.workspacePermissionProfiles": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "newActions": { "type": "string", "enum": ["forbid", "ask", "smart", "permit"] },
              "rules": { "type": "array", "items": {
                "type": "object", "additionalProperties": false,
                "required": ["action", "resource", "effect"],
                "properties": { "action": { "type": "string", "minLength": 1 }, "resource": { "type": "string", "minLength": 1 }, "effect": { "type": "string", "enum": ["allow", "ask", "deny"] }, "match": { "type": "string", "enum": ["glob", "exact"], "default": "glob" } }
              } }
            }
          },
          "markdownDescription": "Additional Workspace / Folder restrictions. Only these explicit scopes are read. Use User or Host keys for earlier layers. Resource paths are relative to the session directory; `${workspace}/*` means inside it."
        },
        "opencodeSessions.command": {
          "type": "string",
          "default": "opencode",
          "description": "Command used to launch OpenCode (for `acp` and `service status`)."
        },
        "opencodeSessions.autoApprovePermissions": {
          "deprecationMessage": "Managed sessions use Permissions / New actions instead. This legacy option is ignored for them.",
          "type": "string",
          "enum": [
            "ask",
            "allowAll"
          ],
          "enumDescriptions": [
            "Ask for confirmation in chat.",
            "Automatically allow all agent requests."
          ],
          "default": "ask",
          "description": "How to handle permission requests from OpenCode."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.opencode/permission-rules.json",
        "url": "./src/schema/permission-rules.schema.json"
      },
      {
        "fileMatch": "**/opencode.json",
        "url": "./src/schema/config.schema.json"
      },
      {
        "fileMatch": "**/opencode.jsonc",
